{
  "name": "@absolutejs/pwa",
  "version": "0.10.1",
  "description": "Framework-agnostic installability, offline Sync, service workers, and Web Push for AbsoluteJS apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/pwa.git"
  },
  "homepage": "https://github.com/absolutejs/pwa",
  "bugs": {
    "url": "https://github.com/absolutejs/pwa/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": "Alex Kahn",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "absolutejs",
    "pwa",
    "web-push",
    "push-notifications",
    "service-worker",
    "offline-sync",
    "background-sync",
    "manifest",
    "vapid"
  ],
  "scripts": {
    "generate:sync-worker": "bun run scripts/generateSyncWorker.ts",
    "build": "bun run generate:sync-worker && rm -rf dist && bun build src/index.ts src/client.ts src/manifest.ts --root ./src --outdir dist --sourcemap --target=bun --external web-push --external @absolutejs/sync --external @absolutejs/sync/client && tsc --project tsconfig.build.json && absolute-manifest emit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "release": "bun run format && bun run typecheck && bun run build && bun publish"
  },
  "dependencies": {
    "@absolutejs/sync": "2.26.1",
    "web-push": "^3.6.7",
    "@absolutejs/manifest": "^0.9.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/web-push": "^3.6.4",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.5.3",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "absolutejs": {
    "manifestContract": 2
  }
}
